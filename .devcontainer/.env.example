# Example .devcontainer/.env file
# Copy this file to .devcontainer/.env and fill in your values
# IMPORTANT: Add .devcontainer/.env to your .gitignore!

# === Secrets Sync Configuration ===
# Choose your storage backend: s3, github, azure, gcs
SECRET_STORE=s3
SECRET_PROFILE=work

# === AWS S3 Authentication ===
# Uncomment and fill in if using S3
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# === GitHub Authentication ===
# Uncomment and fill in if using GitHub releases
# GH_TOKEN=ghp_...

# === Azure Blob Storage Authentication ===
# Uncomment and fill in if using Azure
# AZURE_STORAGE_ACCOUNT=myaccount
# AZURE_STORAGE_KEY=...

# === Google Cloud Storage Authentication ===
# Uncomment and fill in if using GCS
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# === Optional: Fallback to HOMEARCHIVE ===
# If secrets-sync fails, you can still use HOMEARCHIVE* variables
# HOMEARCHIVE=base64-encoded-tarball...
