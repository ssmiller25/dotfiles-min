#!/usr/bin/env bash

# secrets-sync: Cloud-based secrets management for dotfiles
# Supports: AWS S3, GitHub Releases, Azure Blob, Google Cloud Storage

set -e

VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${HOME}/.secrets-profiles.yaml"
STATE_FILE="${HOME}/.secrets-sync-state"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Helper functions
error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

info() {
    echo -e "${BLUE}ℹ ${NC}$1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

debug() {
    if [ "${DEBUG:-0}" = "1" ]; then
        echo -e "${CYAN}[DEBUG]${NC} $1" >&2
    fi
}

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check required dependencies
check_dependencies() {
    local missing=()
    
    # Always required
    if ! command_exists tar; then
        missing+=("tar")
    fi
    
    # Storage-specific
    case "${SECRET_STORE:-}" in
        s3)
            if ! command_exists aws; then
                missing+=("aws-cli (install: pip install awscli)")
            fi
            ;;
        azure)
            if ! command_exists az; then
                missing+=("azure-cli (install: curl -L https://aka.ms/InstallAzureCli | bash)")
            fi
            ;;
        gcs)
            if ! command_exists gsutil; then
                missing+=("google-cloud-sdk (install: curl https://sdk.cloud.google.com | bash)")
            fi
            ;;
        github)
            if ! command_exists gh; then
                missing+=("gh (install: brew install gh or see https://cli.github.com/)")
            fi
            ;;
    esac
    
    if [ ${#missing[@]} -gt 0 ]; then
        error "Missing required dependencies: ${missing[*]}"
    fi
}

# Parse YAML config file (simple parser)
parse_yaml() {
    local file="$1"
    local profile="$2"
    
    if [ ! -f "$file" ]; then
        return 1
    fi
    
    # Extract profile section
    awk -v profile="$profile" '
        /^[[:space:]]*'"$profile"':/ { in_profile=1; next }
        in_profile && /^[[:space:]]*[a-zA-Z0-9_-]+:/ && !/^[[:space:]]{2,}/ { in_profile=0 }
        in_profile && /^[[:space:]]+/ {
            gsub(/^[[:space:]]+/, "")
            gsub(/:[[:space:]]*/, "=")
            print
        }
    ' "$file"
}

# Get profile configuration
get_profile_config() {
    local profile="${1:-${SECRET_PROFILE:-}}"
    
    if [ -z "$profile" ]; then
        # Get default profile
        profile=$(grep "^default:" "$CONFIG_FILE" | cut -d: -f2 | tr -d ' ' || echo "")
    fi
    
    if [ -z "$profile" ]; then
        error "No profile specified and no default profile configured"
    fi
    
    debug "Loading profile: $profile"
    
    # Parse profile from YAML
    local config=$(parse_yaml "$CONFIG_FILE" "$profile")
    
    if [ -z "$config" ]; then
        error "Profile '$profile' not found in $CONFIG_FILE"
    fi
    
    echo "$config"
}

# Initialize configuration file
cmd_init() {
    if [ -f "$CONFIG_FILE" ]; then
        warning "Configuration already exists at $CONFIG_FILE"
        read -p "Overwrite? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi
    
    cat > "$CONFIG_FILE" << 'EOF'
# Secrets Sync Profile Configuration
# Define profiles for different secret sets (work, personal, etc.)

profiles:
  # Example work profile using AWS S3
  work:
    storage: s3
    bucket: my-company-secrets
    prefix: dotfiles/work/
    files:
      - .ssh/config
      - .ssh/id_rsa
      - .ssh/id_rsa.pub
      - .aws/config
      - .aws/credentials
      - .kube/config
  
  # Example personal profile using GitHub releases
  personal:
    storage: github
    repo: myuser/my-secrets
    tag: secrets-v1
    files:
      - .ssh/config
      - .ssh/id_rsa_personal
      - .gitconfig
  
  # Example project-specific profile
  project-alpha:
    storage: s3
    bucket: project-alpha-secrets
    prefix: dotfiles/
    files:
      - .env
      - .aws/credentials

# Default profile to use when SECRET_PROFILE not set
default: work

# Note: All files are encrypted by cloud storage providers at rest.
# For additional client-side encryption, encrypt files with GPG before adding them.
# Example: gpg --encrypt --recipient your@email.com ~/.ssh/id_rsa
EOF
    
    success "Created configuration file: $CONFIG_FILE"
    info "Edit this file to configure your profiles"
    info "Example: vim $CONFIG_FILE"
}

# Add a new profile interactively
cmd_add_profile() {
    local name="$1"
    
    if [ -z "$name" ]; then
        read -p "Profile name: " name
    fi
    
    if [ -z "$name" ]; then
        error "Profile name required"
    fi
    
    echo "Select storage backend:"
    echo "  1) AWS S3"
    echo "  2) GitHub Releases"
    echo "  3) Azure Blob Storage"
    echo "  4) Google Cloud Storage"
    read -p "Choice [1-4]: " choice
    
    case "$choice" in
        1) storage="s3" ;;
        2) storage="github" ;;
        3) storage="azure" ;;
        4) storage="gcs" ;;
        *) error "Invalid choice" ;;
    esac
    
    # Storage-specific configuration
    case "$storage" in
        s3)
            read -p "S3 bucket name: " bucket
            read -p "Prefix (optional, e.g., dotfiles/): " prefix
            ;;
        github)
            read -p "GitHub repo (owner/repo): " repo
            read -p "Release tag (e.g., secrets-v1): " tag
            bucket="$repo"
            prefix="$tag"
            ;;
        azure)
            read -p "Storage account: " bucket
            read -p "Container name: " prefix
            ;;
        gcs)
            read -p "GCS bucket name: " bucket
            read -p "Prefix (optional): " prefix
            ;;
    esac
    
    # Append to config file
    cat >> "$CONFIG_FILE" << EOF

  $name:
    storage: $storage
    bucket: $bucket
    prefix: $prefix
    files:
      # Add files here, e.g.:
      # - .ssh/config
      # - .aws/credentials
EOF
    
    success "Added profile '$name'"
    info "Edit $CONFIG_FILE to add files to this profile"
}

# List available profiles
cmd_list_profiles() {
    if [ ! -f "$CONFIG_FILE" ]; then
        error "No configuration file found. Run: secrets-sync init"
    fi
    
    info "Available profiles:"
    grep "^  [a-zA-Z0-9_-]*:" "$CONFIG_FILE" | sed 's/://g' | sed 's/^  /  • /'
    
    echo ""
    local default=$(grep "^default:" "$CONFIG_FILE" | cut -d: -f2 | tr -d ' ')
    if [ -n "$default" ]; then
        info "Default profile: $default"
    fi
    
    local current="${SECRET_PROFILE:-$default}"
    if [ -n "$current" ]; then
        info "Current profile: $current"
    fi
}

# Show files in a profile
cmd_show() {
    local profile="${1:-${SECRET_PROFILE:-}}"
    
    if [ -z "$profile" ]; then
        profile=$(grep "^default:" "$CONFIG_FILE" | cut -d: -f2 | tr -d ' ')
    fi
    
    if [ -z "$profile" ]; then
        error "No profile specified"
    fi
    
    info "Profile: $profile"
    
    # Extract files from YAML
    awk -v profile="$profile" '
        /^[[:space:]]*'"$profile"':/ { in_profile=1; next }
        in_profile && /^[[:space:]]*[a-zA-Z0-9_-]+:/ && !/^[[:space:]]{4,}/ { in_profile=0 }
        in_profile && /^[[:space:]]*files:/ { in_files=1; next }
        in_files && /^[[:space:]]*-/ {
            gsub(/^[[:space:]]*- /, "")
            print "  • " $0
            next
        }
        in_files && /^[[:space:]]*[a-zA-Z]/ { in_files=0 }
    ' "$CONFIG_FILE"
}

# Download secrets from S3
download_s3() {
    local bucket="$1"
    local prefix="$2"
    local files="$3"
    
    info "Downloading from S3: s3://$bucket/$prefix"
    
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        [[ "$file" =~ ^# ]] && continue
        
        local s3_path="s3://$bucket/${prefix}${file}"
        local local_path="$HOME/$file"
        local local_dir=$(dirname "$local_path")
        
        debug "Downloading: $s3_path -> $local_path"
        
        # Create directory if it doesn't exist
        mkdir -p "$local_dir"
        
        # Download file
        if aws s3 cp "$s3_path" "$local_path" --quiet 2>/dev/null; then
            success "Downloaded: $file"
        else
            warning "Failed to download: $file (may not exist in S3)"
        fi
    done <<< "$files"
}

# Upload secrets to S3
upload_s3() {
    local bucket="$1"
    local prefix="$2"
    local files="$3"
    
    info "Uploading to S3: s3://$bucket/$prefix"
    
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        [[ "$file" =~ ^# ]] && continue
        
        local local_path="$HOME/$file"
        local s3_path="s3://$bucket/${prefix}${file}"
        
        if [ ! -f "$local_path" ]; then
            warning "File not found, skipping: $local_path"
            continue
        fi
        
        debug "Uploading: $local_path -> $s3_path"
        
        # Upload file
        if aws s3 cp "$local_path" "$s3_path" --quiet 2>/dev/null; then
            success "Uploaded: $file"
        else
            error "Failed to upload: $file"
        fi
    done <<< "$files"
}

# Convert file path to safe asset name for GitHub releases
# Uses URL encoding to avoid collisions
path_to_asset_name() {
    local path="$1"
    # Use base64 encoding without padding for safe, unique names
    echo "$path" | base64 | tr -d '=' | tr '+/' '-_'
}

# Convert asset name back to file path
asset_name_to_path() {
    local asset="$1"
    # Reverse the base64 encoding
    local padded="$asset"
    # Add padding if needed
    local mod=$((${#padded} % 4))
    if [ $mod -eq 2 ]; then
        padded="${padded}=="
    elif [ $mod -eq 3 ]; then
        padded="${padded}="
    fi
    echo "$padded" | tr '-_' '+/' | base64 -d
}

# Download secrets from GitHub releases
download_github() {
    local repo="$1"
    local tag="$2"
    local files="$3"
    
    info "Downloading from GitHub: $repo (tag: $tag)"
    
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        [[ "$file" =~ ^# ]] && continue
        
        local asset_name="$(path_to_asset_name "$file")"
        local local_path="$HOME/$file"
        local local_dir=$(dirname "$local_path")
        
        debug "Downloading: $asset_name -> $local_path"
        
        mkdir -p "$local_dir"
        
        # Download from release
        if gh release download "$tag" -R "$repo" -p "$asset_name" -O "$local_path" 2>/dev/null; then
            success "Downloaded: $file"
        else
            warning "Failed to download: $file (may not exist in release)"
        fi
    done <<< "$files"
}

# Upload secrets to GitHub releases
upload_github() {
    local repo="$1"
    local tag="$2"
    local files="$3"
    
    info "Uploading to GitHub: $repo (tag: $tag)"
    
    # Check if release exists
    if ! gh release view "$tag" -R "$repo" >/dev/null 2>&1; then
        info "Creating release: $tag"
        gh release create "$tag" -R "$repo" --title "Secrets $tag" --notes "Secrets archive"
    fi
    
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        [[ "$file" =~ ^# ]] && continue
        
        local local_path="$HOME/$file"
        local asset_name="$(path_to_asset_name "$file")"
        
        if [ ! -f "$local_path" ]; then
            warning "File not found, skipping: $local_path"
            continue
        fi
        
        debug "Uploading: $local_path as $asset_name"
        
        # Delete existing asset if present
        gh release delete-asset "$tag" "$asset_name" -R "$repo" -y 2>/dev/null || true
        
        # Upload new asset
        if gh release upload "$tag" "$local_path#$asset_name" -R "$repo" 2>/dev/null; then
            success "Uploaded: $file"
        else
            error "Failed to upload: $file"
        fi
    done <<< "$files"
}

# Pull secrets from remote storage
cmd_pull() {
    local profile="${SECRET_PROFILE:-}"
    local force=false
    
    # Parse options
    while [[ $# -gt 0 ]]; do
        case $1 in
            --profile)
                profile="$2"
                shift 2
                ;;
            --force|-f)
                force=true
                shift
                ;;
            *)
                error "Unknown option: $1"
                ;;
        esac
    done
    
    if [ ! -f "$CONFIG_FILE" ]; then
        error "No configuration file found. Run: secrets-sync init"
    fi
    
    check_dependencies
    
    # Get profile configuration
    local config=$(get_profile_config "$profile")
    
    # Extract configuration values
    local storage=$(echo "$config" | grep "^storage=" | cut -d= -f2)
    local bucket=$(echo "$config" | grep "^bucket=" | cut -d= -f2)
    local prefix=$(echo "$config" | grep "^prefix=" | cut -d= -f2)
    
    # Get files list
    local files=$(awk -v profile="${profile:-$(grep "^default:" "$CONFIG_FILE" | cut -d: -f2 | tr -d ' ')}" '
        /^[[:space:]]*'"${profile}"':/ { in_profile=1; next }
        in_profile && /^[[:space:]]*[a-zA-Z0-9_-]+:/ && !/^[[:space:]]{4,}/ { in_profile=0 }
        in_profile && /^[[:space:]]*files:/ { in_files=1; next }
        in_files && /^[[:space:]]*-/ {
            gsub(/^[[:space:]]*- /, "")
            print
            next
        }
        in_files && /^[[:space:]]*[a-zA-Z]/ { in_files=0 }
    ' "$CONFIG_FILE")
    
    if [ -z "$files" ]; then
        error "No files configured for profile"
    fi
    
    # Download based on storage type
    case "$storage" in
        s3)
            download_s3 "$bucket" "$prefix" "$files"
            ;;
        github)
            download_github "$bucket" "$prefix" "$files"
            ;;
        azure|gcs)
            error "Storage backend '$storage' not yet implemented"
            ;;
        *)
            error "Unknown storage backend: $storage"
            ;;
    esac
    
    success "Secrets synced successfully"
}

# Push secrets to remote storage
cmd_push() {
    local profile="${SECRET_PROFILE:-}"
    local specific_file=""
    
    # Parse options
    while [[ $# -gt 0 ]]; do
        case $1 in
            --profile)
                profile="$2"
                shift 2
                ;;
            --file)
                specific_file="$2"
                shift 2
                ;;
            *)
                if [ -z "$specific_file" ] && [ -f "$1" ]; then
                    specific_file="$1"
                    shift
                else
                    error "Unknown option: $1"
                fi
                ;;
        esac
    done
    
    if [ ! -f "$CONFIG_FILE" ]; then
        error "No configuration file found. Run: secrets-sync init"
    fi
    
    check_dependencies
    
    # Get profile configuration
    local config=$(get_profile_config "$profile")
    
    # Extract configuration values
    local storage=$(echo "$config" | grep "^storage=" | cut -d= -f2)
    local bucket=$(echo "$config" | grep "^bucket=" | cut -d= -f2)
    local prefix=$(echo "$config" | grep "^prefix=" | cut -d= -f2)
    
    # Get files list
    local files=$(awk -v profile="${profile:-$(grep "^default:" "$CONFIG_FILE" | cut -d: -f2 | tr -d ' ')}" '
        /^[[:space:]]*'"${profile}"':/ { in_profile=1; next }
        in_profile && /^[[:space:]]*[a-zA-Z0-9_-]+:/ && !/^[[:space:]]{4,}/ { in_profile=0 }
        in_profile && /^[[:space:]]*files:/ { in_files=1; next }
        in_files && /^[[:space:]]*-/ {
            gsub(/^[[:space:]]*- /, "")
            print
            next
        }
        in_files && /^[[:space:]]*[a-zA-Z]/ { in_files=0 }
    ' "$CONFIG_FILE")
    
    if [ -z "$files" ]; then
        error "No files configured for profile"
    fi
    
    # If specific file specified, filter to just that file
    if [ -n "$specific_file" ]; then
        specific_file="${specific_file#$HOME/}"
        specific_file="${specific_file#./}"
        files=$(echo "$files" | grep "^$specific_file$")
        if [ -z "$files" ]; then
            error "File '$specific_file' not in profile configuration"
        fi
    fi
    
    # Upload based on storage type
    case "$storage" in
        s3)
            upload_s3 "$bucket" "$prefix" "$files"
            ;;
        github)
            upload_github "$bucket" "$prefix" "$files"
            ;;
        azure|gcs)
            error "Storage backend '$storage' not yet implemented"
            ;;
        *)
            error "Unknown storage backend: $storage"
            ;;
    esac
    
    success "Secrets pushed successfully"
}

# Add a file to a profile
cmd_add() {
    local file="$1"
    local profile="${2:-${SECRET_PROFILE:-}}"
    
    if [ -z "$file" ]; then
        error "File path required"
    fi
    
    if [ -z "$profile" ]; then
        profile=$(grep "^default:" "$CONFIG_FILE" | cut -d: -f2 | tr -d ' ')
    fi
    
    if [ -z "$profile" ]; then
        error "Profile not specified and no default profile set"
    fi
    
    # Normalize file path
    file="${file#$HOME/}"
    file="${file#./}"
    
    if [ ! -f "$HOME/$file" ]; then
        warning "File does not exist: $HOME/$file"
        read -p "Add anyway? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi
    
    # Add to config file
    # Find the files: line for this profile and add the file
    awk -v profile="$profile" -v file="$file" '
        /^[[:space:]]*'"$profile"':/ { in_profile=1 }
        in_profile && /^[[:space:]]*[a-zA-Z0-9_-]+:/ && !/^[[:space:]]{4,}/ { in_profile=0 }
        in_profile && /^[[:space:]]*files:/ { 
            in_files=1
            print
            print "      - " file
            next
        }
        { print }
    ' "$CONFIG_FILE" > "$CONFIG_FILE.tmp"
    
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
    
    success "Added $file to profile $profile"
}

# Migrate from HOMEARCHIVE environment variables
cmd_migrate() {
    local from_env="$1"
    local to_profile="$2"
    
    if [ -z "$from_env" ] || [ -z "$to_profile" ]; then
        error "Usage: secrets-sync migrate <FROM_ENV> <TO_PROFILE>"
    fi
    
    # Check if environment variable exists
    if [ -z "${!from_env:-}" ]; then
        error "Environment variable $from_env not set"
    fi
    
    info "Migrating from $from_env to profile $to_profile"
    
    # Extract archive
    local temp_dir=$(mktemp -d /tmp/secrets-migrate.XXXXXX)
    
    if ! echo -n "${!from_env}" | base64 -d | tar -xzf - -C "$temp_dir" 2>/dev/null; then
        rm -rf "$temp_dir"
        error "Failed to extract archive from $from_env"
    fi
    
    # List files in archive
    info "Files in archive:"
    local files=$(cd "$temp_dir" && find . -type f | sed 's|^\./||')
    echo "$files" | sed 's/^/  • /'
    
    # Add files to profile
    echo "$files" | while IFS= read -r file; do
        cmd_add "$file" "$to_profile"
    done
    
    # Copy files to home directory
    cp -r "$temp_dir"/* "$HOME/"
    
    rm -rf "$temp_dir"
    
    success "Migration complete"
    info "Next steps:"
    info "  1. Run: secrets-sync push --profile $to_profile"
    info "  2. Remove environment variable: unset $from_env"
}

# Switch active profile
cmd_switch() {
    local profile="$1"
    
    if [ -z "$profile" ]; then
        error "Profile name required"
    fi
    
    # Verify profile exists
    if ! grep -q "^  $profile:" "$CONFIG_FILE"; then
        error "Profile '$profile' not found"
    fi
    
    # Update shell environment (for current session only)
    export SECRET_PROFILE="$profile"
    
    success "Switched to profile: $profile"
    info "To make permanent, add to your shell config:"
    info "  export SECRET_PROFILE=$profile"
    
    # Optionally pull secrets
    read -p "Pull secrets for this profile now? [Y/n] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Nn]$ ]]; then
        cmd_pull
    fi
}

# Show help
cmd_help() {
    cat << 'EOF'
secrets-sync - Cloud-based secrets management for dotfiles

USAGE:
    secrets-sync <command> [options]

COMMANDS:
    init
        Initialize configuration file
    
    add-profile [name]
        Add a new profile interactively
    
    list-profiles
        List all available profiles
    
    show [profile]
        Show files in a profile
    
    pull [--profile PROFILE] [--force]
        Download secrets from remote storage
    
    push [--profile PROFILE] [--file FILE]
        Upload secrets to remote storage
    
    add <file> [profile]
        Add a file to a profile
    
    switch <profile>
        Switch to a different profile
    
    migrate <FROM_ENV> <TO_PROFILE>
        Migrate from HOMEARCHIVE* environment variable
    
    help
        Show this help message

ENVIRONMENT VARIABLES:
    SECRET_STORE      Storage backend (s3, github, azure, gcs)
    SECRET_PROFILE    Profile to use
    
    AWS S3:
      AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION
    
    GitHub:
      GH_TOKEN (or use: gh auth login)
    
    Azure:
      AZURE_STORAGE_ACCOUNT, AZURE_STORAGE_KEY
    
    Google Cloud:
      GOOGLE_APPLICATION_CREDENTIALS

EXAMPLES:
    # Initial setup
    secrets-sync init
    secrets-sync add-profile work
    secrets-sync add ~/.ssh/config work
    secrets-sync push --profile work
    
    # Daily usage
    export SECRET_PROFILE=work
    secrets-sync pull
    
    # Update a file
    vim ~/.ssh/config
    secrets-sync push ~/.ssh/config
    
    # Switch profiles
    secrets-sync switch personal

EOF
}

# Main
main() {
    local command="${1:-help}"
    shift || true
    
    case "$command" in
        init)
            cmd_init "$@"
            ;;
        add-profile)
            cmd_add_profile "$@"
            ;;
        list-profiles|list|ls)
            cmd_list_profiles "$@"
            ;;
        show)
            cmd_show "$@"
            ;;
        pull|sync|download)
            cmd_pull "$@"
            ;;
        push|upload)
            cmd_push "$@"
            ;;
        add)
            cmd_add "$@"
            ;;
        migrate)
            cmd_migrate "$@"
            ;;
        switch)
            cmd_switch "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            echo "secrets-sync version $VERSION"
            ;;
        *)
            error "Unknown command: $command (try 'help')"
            ;;
    esac
}

main "$@"
