#!/usr/bin/env bash

# ham (Home Archive Manager): Manage HOMEARCHIVE environment variables
# Usage: ham [command] [options]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST_FILE="${HOME}/.homearchive-manifest"

# ---------------------------------------------------------------------------
# Shell compatibility helpers
# ---------------------------------------------------------------------------
is_interactive() { [[ -t 0 ]] && [[ -t 1 ]]; return $?; }

# Detect OS for platform-specific tools
detect_os() {
    case "$(uname -s)" in
        Darwin)  echo "macos"  ;;
        Linux)   echo "linux"  ;;
        *)       echo "unknown" ;;
    esac
}

# ---------------------------------------------------------------------------
# Color output
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

die() {
    echo -e "${RED}Error: $*${NC}" >&2
    exit 1
}

info()  { echo -e "${BLUE}ℹ ${NC}$1"; }
ok()    { echo -e "${GREEN}✓${NC} $1"; }
warn()  { echo -e "${YELLOW}⚠${NC} $1"; }

# ---------------------------------------------------------------------------
# Require a CLI tool (with an install hint)
# ---------------------------------------------------------------------------
require_cmd() {
    local cmd="$1"
    local hint="${2:-}"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        die "'$cmd' is required but not found.${hint:+ $hint}"
    fi
}

# ---------------------------------------------------------------------------
# Manifest locking (mkdir is atomic on both macOS and Linux)
# ---------------------------------------------------------------------------
manifest_lock() {
    local lock_dir="${MANIFEST_FILE}.lock"
    local i=0
    while ! mkdir "$lock_dir" 2>/dev/null; do
        sleep 0.1
        i=$((i + 1))
        if [ "$i" -ge 50 ]; then
            die "Could not acquire manifest lock after 5s"
        fi
    done
}

manifest_unlock() {
    rmdir "${MANIFEST_FILE}.lock" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Safe sed – escape regex metacharacters in file paths
# ---------------------------------------------------------------------------
escape_sed() {
    printf '%s' "$1" | sed 's/[.[\*^$()+?{|]/\\&/g'
}

# ---------------------------------------------------------------------------
# Initialise manifest file if it doesn't exist
# ---------------------------------------------------------------------------
init_manifest() {
    manifest_lock
    if [ ! -f "$MANIFEST_FILE" ]; then
        cat > "$MANIFEST_FILE" << 'EOF'
# HOMEARCHIVE Manifest
# Format: ARCHIVE_NAME:file1:file2:file3
# Lines starting with # are comments
# File paths are relative to $HOME

# Example:
# HOMEARCHIVE:.ssh/id_rsa:.ssh/config:.ssh/known_hosts
# HOMEARCHIVE_AWS:.aws/credentials:.aws/config
EOF
        ok "Created manifest file: $MANIFEST_FILE"
    fi
    manifest_unlock
}

# ---------------------------------------------------------------------------
# Find which archive contains a given file
# ---------------------------------------------------------------------------
find_archive_for_file() {
    local file="$1"
    local normalized_file="${file#$HOME/}"
    normalized_file="${normalized_file#./}"

    if [ ! -f "$MANIFEST_FILE" ]; then
        return 1
    fi

    local archive_name files_list
    while IFS=':' read -r archive_name files_list || [ -n "$archive_name" ]; do
        # Skip comments and blank lines
        [[ "$archive_name" =~ ^#.*$ ]] && continue
        [[ -z "$archive_name" ]] && continue
        # ... and lines that have no file list (trailing colon edge case)
        [[ -z "$files_list" ]] && continue

        IFS=':' read -ra FILES <<< "$files_list"
        for f in "${FILES[@]}"; do
            [[ -z "$f" ]] && continue
            if [ "$f" = "$normalized_file" ]; then
                printf '%s' "$archive_name"
                return 0
            fi
        done
    done < "$MANIFEST_FILE"

    return 1
}

# ---------------------------------------------------------------------------
# Get all files for an archive from the manifest
# ---------------------------------------------------------------------------
get_archive_files() {
    local archive_name="$1"

    if [ ! -f "$MANIFEST_FILE" ]; then
        return 1
    fi

    local name rest
    while IFS=':' read -r name rest || [ -n "$name" ]; do
        [[ "$name" =~ ^#.*$ ]] && continue
        [[ -z "$name" ]] && continue

        if [ "$name" = "$archive_name" ]; then
            printf '%s\n' "$rest" | tr ':' '\n' | grep -v '^$'
            return 0
        fi
    done < "$MANIFEST_FILE"

    return 1
}

# ---------------------------------------------------------------------------
# Check archive size against GitHub's 48 KB secret limit
# ---------------------------------------------------------------------------
warn_if_large() {
    local archive_file="$1"
    local archive_name="$2"
    local max_kb=48

    if [ -f "$archive_file" ]; then
        local size_kb
        size_kb=$(du -k "$archive_file" | cut -f1)
        if [ "$size_kb" -gt "$max_kb" ]; then
            warn "$archive_name archive is ${size_kb}KB (GitHub secret limit is ${max_kb}KB) – upload may fail"
            if is_interactive; then
                read -r -p "Continue anyway? [y/N] " reply
                [[ "$reply" =~ ^[Yy]$ ]] || die "Aborted."
            else
                warn "Non-interactive mode – continuing (upload may fail)"
            fi
        fi
    fi
}

# ---------------------------------------------------------------------------
# Create archive from files listed in the manifest
# ---------------------------------------------------------------------------
create_archive() {
    local archive_name="$1"
    local output_file="$2"

    info "Creating archive $archive_name..."

    local files
    files=$(get_archive_files "$archive_name")
    if [ -z "$files" ]; then
        die "No files found for archive $archive_name in manifest"
    fi

    local existing_files=() missing_files=()
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        local full_path="$HOME/$file"
        if [ -e "$full_path" ]; then
            existing_files+=("$file")
        else
            missing_files+=("$file")
        fi
    done <<< "$files"

    if [ ${#missing_files[@]} -gt 0 ]; then
        warn "Missing files (will be skipped):"
        printf '  - %s\n' "${missing_files[@]}"
    fi

    if [ ${#existing_files[@]} -eq 0 ]; then
        die "No files exist for archive $archive_name"
    fi

    info "Including ${#existing_files[@]} file(s):"
    printf '  - %s\n' "${existing_files[@]}"

    # Create archive
    cd "$HOME"
    printf '%s\n' "${existing_files[@]}" | tar -czf "$output_file" -T - 2>/dev/null

    ok "Archive created: $output_file"
    warn_if_large "$output_file" "$archive_name"
}

# ---------------------------------------------------------------------------
# Encode archive to base64 (OS-aware)
# ---------------------------------------------------------------------------
encode_archive() {
    local archive_file="$1"
    local os
    os=$(detect_os)
    if [ "$os" = "macos" ]; then
        base64 -i "$archive_file" -o "${archive_file}.b64"
    else
        base64 -w 0 "$archive_file" > "${archive_file}.b64"
    fi
}

# ---------------------------------------------------------------------------
# Update a GitHub variable via the gh CLI
# ---------------------------------------------------------------------------
update_github_variable() {
    local archive_name="$1"
    local archive_file="$2"
    local target="$3"
    local target_name="$4"

    info "Encoding archive to base64..."
    encode_archive "$archive_file"

    local encoded_file="${archive_file}.b64"
    local encoded_value
    encoded_value=$(cat "$encoded_file")

    info "Updating GitHub variable $archive_name..."

    case "$target" in
        repo)
            if [ -z "$target_name" ]; then
                target_name=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
                if [ -z "$target_name" ]; then
                    die "Not in a git repository. Specify repo with --repo OWNER/REPO"
                fi
            fi
            gh variable set "$archive_name" --body "$encoded_value" --repo "$target_name"
            ;;
        env)
            if [ -z "$target_name" ]; then
                die "Environment name required with --env ENV_NAME"
            fi
            gh variable set "$archive_name" --body "$encoded_value" --env "$target_name"
            ;;
        codespace)
            # Codespace env updates can fail for various reasons – capture and explain
            if ! gh codespace env set "$archive_name" --value "$encoded_value"; then
                warn "Unable to save Codespaces secret automatically. Save this value manually:"
                echo "-----BEGIN HOMEARCHIVE ${archive_name}-----"
                printf '%s' "$encoded_value"
                echo ""
                echo "-----END HOMEARCHIVE ${archive_name}-----"
                return 1
            fi
            ;;
        *)
            die "Invalid target: $target (use: repo, env, or codespace)"
            ;;
    esac

    ok "GitHub variable $archive_name updated successfully"

    # Cleanup
    rm -f "$encoded_file"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# update  –  rebuild the archive containing a file and push to GitHub
cmd_update() {
    local file="$1"
    local target="repo"
    local target_name=""
    local dry_run=false

    shift

    while [[ $# -gt 0 ]]; do
        case $1 in
            --repo)
                target="repo"; target_name="$2"; shift 2 ;;
            --env)
                target="env";  target_name="$2"; shift 2 ;;
            --codespace)
                target="codespace"; shift ;;
            --dry-run)
                dry_run=true; shift ;;
            *)
                die "Unknown option: $1" ;;
        esac
    done

    if [ -z "$file" ]; then
        die "File path required"
    fi

    # Normalize the path
    file="${file#$HOME/}"
    file="${file#./}"

    info "Looking up archive for file: $file"

    local archive_name
    archive_name=$(find_archive_for_file "$file") || true
    if [ -z "$archive_name" ]; then
        die "File $file not found in any archive. Use 'add' command to add it first."
    fi

    info "Found in archive: $archive_name"

    # Create temporary archive in a temp directory (no suffix on mktemp)
    local temp_dir
    temp_dir=$(mktemp -d /tmp/homearchive.XXXXXX)
    local temp_archive="${temp_dir}/${archive_name}.tar.gz"
    create_archive "$archive_name" "$temp_archive"

    if [ "$dry_run" = true ]; then
        info "Dry run mode – archive created but not uploaded"
        info "Archive size: $(du -h "$temp_archive" | cut -f1)"
        info "Would update GitHub variable: $archive_name (target: $target)"
        rm -rf "$temp_dir"
        return 0
    fi

    update_github_variable "$archive_name" "$temp_archive" "$target" "$target_name"
    rm -rf "$temp_dir"
}

# add  –  register a file in the manifest for a given archive
cmd_add() {
    local file="$1"
    local archive_name="$2"

    if [ -z "$file" ]; then
        die "File path required"
    fi

    file="${file#$HOME/}"
    file="${file#./}"

    if [ ! -e "$HOME/$file" ]; then
        die "File does not exist: $HOME/$file"
    fi

    # Interactive fallback when no archive name is given
    if [ -z "$archive_name" ]; then
        if ! is_interactive; then
            die "Archive name required in non-interactive mode. Usage: ham add <file> <archive>"
        fi
        info "Available archives:"
        grep -v '^#' "$MANIFEST_FILE" 2>/dev/null | grep -v '^$' | cut -d: -f1 | sort -u | nl
        echo "  Or enter a new archive name"
        read -r -p "Archive name: " archive_name
    fi

    # Already in an archive?
    local existing_archive
    existing_archive=$(find_archive_for_file "$file" 2>/dev/null) || true
    if [ -n "$existing_archive" ]; then
        warn "File already in archive: $existing_archive"
        if is_interactive; then
            read -r -p "Remove from $existing_archive and add to $archive_name? [y/N] " reply
            [[ "$reply" =~ ^[Yy]$ ]] || die "Aborted."
        else
            die "File already archived in $existing_archive. Use --force to move it, or remove it manually."
        fi
    fi

    manifest_lock

    # Remove from old archive (safe sed – escape path)
    local escaped_file
    escaped_file=$(escape_sed "$file")
    if [ -n "${existing_archive:-}" ]; then
        sed -i.bak "s|:${escaped_file}\b||g" "$MANIFEST_FILE"
        # Clean up trailing/empty colons and empty lines
        sed -i.bak -E 's|:+|:|g' "$MANIFEST_FILE"
        sed -i.bak -E 's|^([A-Za-z_]+):$|#\1: (empty)|' "$MANIFEST_FILE"
        rm -f "${MANIFEST_FILE}.bak"
    fi

    # Add to target archive
    if grep -q "^${archive_name}:" "$MANIFEST_FILE"; then
        sed -i.bak "s|^${archive_name}:.*|&:${file}|" "$MANIFEST_FILE"
        rm -f "${MANIFEST_FILE}.bak"
        # Clean up any doubled colons the append might have created
        sed -i.bak -E 's|:+|:|g' "$MANIFEST_FILE"
        rm -f "${MANIFEST_FILE}.bak"
    else
        printf '%s:%s\n' "$archive_name" "$file" >> "$MANIFEST_FILE"
    fi

    manifest_unlock

    ok "Added $file to $archive_name"
}

# list  –  show archives or files within an archive
cmd_list() {
    local archive_name="$1"

    init_manifest

    if [ -z "$archive_name" ]; then
        info "Available archives:"
        while IFS=':' read -r name rest; do
            [[ "$name" =~ ^#.*$ ]] && continue
            [[ -z "$name" ]] && continue
            local file_count
            file_count=$(printf '%s' "$rest" | tr ':' '\n' | grep -vc '^$')
            echo "  • $name ($file_count files)"
        done < <(grep -v '^#' "$MANIFEST_FILE" | grep -v '^$')
    else
        info "Files in $archive_name:"
        local file
        while IFS= read -r file; do
            [[ -z "$file" ]] && continue
            if [ -e "$HOME/$file" ]; then
                echo "  ✓ $file"
            else
                echo "  ✗ $file (missing)"
            fi
        done < <(get_archive_files "$archive_name")
    fi
}

# create  –  build an archive without uploading
cmd_create() {
    local archive_name="$1"
    local output_file="$2"
    local no_encode=false

    # Parse optional flag
    while [[ $# -gt 0 ]]; do
        case $1 in
            --no-encode)
                no_encode=true; shift ;;
            *)
                archive_name="$1"
                output_file="${2:-}"
                shift 2 2>/dev/null || shift
                ;;
        esac
    done

    if [ -z "$archive_name" ]; then
        die "Archive name required"
    fi

    if [ -z "$output_file" ]; then
        output_file="${archive_name}.tar.gz"
    fi

    create_archive "$archive_name" "$output_file"

    if [ "$no_encode" = false ]; then
        encode_archive "$output_file"
        ok "Archive and base64 file created:"
        echo "  Archive: $output_file"
        echo "  Base64:  ${output_file}.b64"
    else
        ok "Archive created (not encoded): $output_file"
    fi
}

# init  –  create skeleton manifest
cmd_init() {
    init_manifest
    info "Edit the manifest file to define your archives:"
    echo "  $MANIFEST_FILE"
}

# help
cmd_help() {
    cat << 'EOF'
ham (Home Archive Manager) – Manage HOMEARCHIVE environment variables

USAGE:
    ham <command> [options]

COMMANDS:
    init
        Initialize the manifest file

    add <file> [archive-name]
        Add a file to an archive (interactive if archive-name not provided;
        archive-name is required in non-interactive mode)
        Example: ham add ~/.ssh/config HOMEARCHIVE_SSH

    update <file> [options]
        Update the archive containing <file> and push to GitHub.
        Options:
            --repo OWNER/REPO    Update repository variable (default)
            --env ENV_NAME       Update environment variable
            --codespace          Update codespace variable
            --dry-run            Create archive but don't upload
        Example: ham update ~/.ssh/config --repo myorg/myrepo

    list [archive-name]
        List all archives or files in a specific archive
        Example: ham list HOMEARCHIVE_SSH

    create <archive-name> [output-file] [--no-encode]
        Create an archive file (for manual use).
        --no-encode  Skip base64 encoding (debugging)
        Example: ham create HOMEARCHIVE_SSH ssh-backup.tar.gz

    help
        Show this help message

WORKFLOW:
    1. Initialize: ham init
    2. Add files:  ham add ~/.ssh/config HOMEARCHIVE_SSH
    3. Update:     ham update ~/.ssh/config

MANIFEST FILE:
    Location: ~/.homearchive-manifest
    Format:   ARCHIVE_NAME:file1:file2:file3
    Files are relative to $HOME

EOF
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
main() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        init)
            cmd_init "$@"
            ;;
        add)
            init_manifest
            cmd_add "$@"
            ;;
        update)
            require_cmd gh "Install from https://cli.github.com"
            init_manifest
            cmd_update "$@"
            ;;
        list|ls)
            cmd_list "$@"
            ;;
        create)
            init_manifest
            cmd_create "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            die "Unknown command: $command (try 'help')"
            ;;
    esac
}

main "$@"
